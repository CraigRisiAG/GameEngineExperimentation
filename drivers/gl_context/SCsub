

#!/usr/bin/env python
"""
SCons build script for configuring and compiling OpenGL context drivers.
This script conditionally includes GLAD (GL/GLES loader generator) library
for supported platforms and adds OpenGL context driver source files to the
build environment.
The script:
- Checks if the target platform supports OpenGL (haiku, osx, windows, x11)
- Configures GLAD as a third-party dependency with appropriate compiler flags
- Enables GLAD and sets up GLES-over-GL rendering mode
- Compiles third-party GLAD sources with warnings disabled
- Adds all C++ driver source files to the build
Platforms supported:
    - haiku: BeOS-like operating system
    - osx: macOS
    - windows: Windows operating systems
    - x11: Linux and Unix-like systems with X11 display server
Environment variables modified:
    - CPPPATH: Adds third-party include directories
    - CPPDEFINES: Adds preprocessor definitions for GLAD and GLES
    - drivers_sources: Accumulates source files for the drivers module
"""

Import('env')

if (env["platform"] in ["haiku", "osx", "windows", "x11"]):
    # Thirdparty source files
    thirdparty_dir = "#thirdparty/glad/"
    thirdparty_sources = [
        "glad.c",
    ]
    thirdparty_sources = [thirdparty_dir + file for file in thirdparty_sources]

    env.Prepend(CPPPATH=[thirdparty_dir])

    env.Append(CPPDEFINES=['GLAD_ENABLED'])
    env.Append(CPPDEFINES=['GLES_OVER_GL'])

    env_thirdparty = env.Clone()
    env_thirdparty.disable_warnings()
    env_thirdparty.add_source_files(env.drivers_sources, thirdparty_sources)

# Godot source files
env.add_source_files(env.drivers_sources, "*.cpp")
